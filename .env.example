# --- Actual Budget server (required) ---
# URL of your actual-server, as you open it in the browser.
ACTUAL_SERVER_URL=https://actual.example.com
# Server password (the one you type on the Actual login screen).
ACTUAL_PASSWORD=change-me
# Budget "Sync ID": Actual → Settings → Advanced settings → Sync ID.
ACTUAL_SYNC_ID=00000000-0000-0000-0000-000000000000
# Only if your budget file is end-to-end encrypted.
# ACTUAL_E2E_PASSWORD=
# Set to 1 if your actual-server uses a self-signed certificate.
# ACTUAL_INSECURE_TLS=0

# --- Dashboard ---
# Login password for the dashboard. Leave unset to disable the login screen (LAN-only setups).
DASH_PASSWORD=change-me
# Optional token for other dashboards: GET /api/summary or /api/overview with
# "Authorization: Bearer <API_TOKEN>" skips the login. Only used when DASH_PASSWORD is set.
# API_TOKEN=
# Where the downloaded budget cache lives (a Docker volume in production).
ACTUAL_DATA_DIR=./data
# Pull changes from the server every N minutes (the refresh button always syncs immediately).
SYNC_INTERVAL_MIN=15

# --- Rules (all optional) ---
# These are the defaults. The settings page (gear icon) overrides them and stores the overrides in
# ACTUAL_DATA_DIR/settings.json; "Reset to defaults" goes back to these values.
# Accounts excluded from KPIs and charts, by name or id, comma-separated. Off-budget accounts are
# always excluded. Their transactions still show in the list, greyed out.
# EXCLUDED_ACCOUNTS=Savings pot,Brokerage
# Categories excluded from KPIs and charts, by name or id, comma-separated: money set aside rather
# than spent, such as savings or investment contributions to off-budget accounts.
# EXCLUDED_CATEGORIES=Savings,Investments
# Tags hidden from the tag strip (e.g. markers written by automations), comma-separated.
# HIDDEN_TAGS=#auto-categorized
# Number formatting.
LOCALE=en-US
CURRENCY=EUR
# Earliest date loaded from the budget (YYYY-MM-DD). Defaults to 13 months ago.
# HISTORY_SINCE=2020-01-01

# --- Demo ---
# Serve a made-up budget instead of a real one (no Actual server needed; edits and settings stay in memory).
# DEMO=1
